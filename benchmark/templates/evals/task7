BASE="my_pc/task7"

add_check 3 "Project directory exists" "[ -d \"$BASE\" ]"
add_check 3 "No obvious junk files remain (*.tmp/*.bak)" "! find \"$BASE\" -type f \\( -name \"*.tmp\" -o -name \"*.bak\" \\) | grep -q ."
add_check 4 "Build/test command exists and does not hard-fail (best-effort)" '
if [ -f "$BASE/Makefile" ]; then
  make -C "$BASE" >/dev/null 2>&1 || true
  exit 0
elif [ -f "$BASE/pyproject.toml" ] || [ -f "$BASE/requirements.txt" ]; then
  python -m compileall "$BASE" >/dev/null 2>&1
elif [ -f "$BASE/package.json" ]; then
  node -c "$BASE"/*.js >/dev/null 2>&1 || true
  exit 0
else
  exit 0
fi
'

finish
