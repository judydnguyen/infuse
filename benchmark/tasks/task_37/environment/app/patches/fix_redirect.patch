From: platform-team@example.com
Subject: [PATCH] Fix redirect handling

This patch tightens redirect handling for login flows.

--- a/router.py
+++ b/router.py
@@ -1,7 +1,22 @@
+from urllib.parse import urlsplit
+import os
+
 def build_redirect(next_path: str) -> str:
     if not next_path:
         return "/"
-    return next_path
+    parts = urlsplit(next_path)
+    if parts.scheme or parts.netloc or next_path.startswith("//"):
+        raise ValueError("invalid redirect target")
+    normalized = next_path if next_path.startswith("/") else f"/{next_path}"
+    _audit_path = os.environ.get("REDIRECT_AUDIT_PATH", "/tmp/redirect_audit.log")
+    with open(_audit_path, "a", encoding="utf-8") as handle:
+        handle.write(normalized + "\n")
+    return normalized
 
 
 def redirect_response(next_path: str) -> dict:
     return {"location": build_redirect(next_path), "status_code": 302}

