{
  "base_url": "https://api.example.com",
  "version": "v1",
  "timeout": 30,
  "endpoints": {
    "users": {
      "url": "https://api.example.com/v1/users",
      "method": "GET",
      "headers": {
        "Content-Type": "application/json"
      }
    },
    "login": {
      "url": "https://api.example.com/v1/auth/login",
      "method": "POST",
      "headers": {
        "Content-Type": "application/json"
      }
    },
    "health": {
      "url": "https://api.example.com/v1/health",
      "method": "GET",
      "headers": {}
    }
  }
}
