# --- API keys (set only what you use) ---------------------------------------
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
HF_TOKEN=

# --- Where trajectories and judge outputs are written ------------------------
# Defaults to <repo>/results when unset. Point at a large volume for full runs.
# DATA_ROOT_PATH=/path/to/agentbench-data

# --- Optional: route OpenAI-family calls through an OpenAI-compatible gateway -
# AGENT_MODEL_GATEWAY=1
# GATEWAY_API_BASE=https://gateway.example.com/v1
# GATEWAY_API_KEY=
# AGENT_RPM_LIMIT=60

# --- Optional: defense model served by a local vLLM instance -----------------
# DEFENSE_VLLM_API_BASE=http://localhost:8013/v1
# DEFENSE_MODEL_RPM=60

# --- Optional: local HF cache for open-weight models --------------------------
# HF_HOME=/path/to/huggingface
